# Copy this file to ".env" and put your real key in it
GEMINI_API_KEY=your_api_key_here

# Optional: change model names if these are retired (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.8-flash
# If these stop working, check https://ai.google.dev/gemini-api/docs/models
# for the current model names and update the two lines above.
